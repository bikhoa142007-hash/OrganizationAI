APP_ENV=demo
DEMO_DATABASE=runtime/demo-organization.sqlite3
DEMO_MOCK_MODE=pass
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Hosted Judge Demo (configure in Render, not a committed .env):
# APP_ENV remains demo; production rejects demo actors.
# DEMO_DATABASE=/tmp/organizationai/demo-organization.sqlite3
# CORS_ORIGINS=https://<actual-frontend-host> (one exact origin, no trailing slash)
# PORT is supplied by the hosting platform.

# Render Free SQLite is disposable; no submitted data persistence is promised.
