APP_ENV=demo
DEMO_DATABASE=runtime/demo-organization.sqlite3
DEMO_MOCK_MODE=pass
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL for the new authentication module only; the approval demo remains on SQLite.
POSTGRES_DB=organizationai
POSTGRES_USER=organizationai
POSTGRES_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql+psycopg://organizationai:replace-with-a-local-only-password@db:5432/organizationai

# Replace both placeholders locally. Never reuse these values in a deployed environment.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_REMEMBER_TOKEN_DAYS=14
AUTH_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_SEED_PASSWORD=replace-with-a-local-only-password

# Auth workflow pipeline. The local model endpoint is explicit and blank by default,
# so private plan images are never sent until an operator configures a runtime.
AUTH_WORKFLOW_AI_PROVIDER=LOCAL_VLM
LOCAL_VLM_MODEL=
# Root URL for an OpenAI-compatible Chat Completions endpoint, including /v1.
# In Docker Desktop, use the host runtime address, e.g. http://host.docker.internal:8000/v1.
# Do not use localhost here: it points to the backend container itself.
LOCAL_VLM_BASE_URL=
# Off by default: non-local endpoints require HTTPS and explicit operator approval.
LOCAL_VLM_ALLOW_REMOTE=false
# Optional. Keep real credentials only in the untracked local .env or a secret store.
LOCAL_VLM_API_KEY=
LOCAL_VLM_TIMEOUT_SECONDS=30
LOCAL_VLM_MAX_OUTPUT_TOKENS=1536
LOCAL_VLM_MAX_RESPONSE_BYTES=262144
LOCAL_VLM_MAX_INPUT_BYTES=20971520
# MOCK_VLM is an explicit local demo option; it never replaces Local VLM silently.
AUTH_WORKFLOW_MOCK_SCENARIO=pass
AUTH_WORKFLOW_MOCK_MODEL_VERSION=mock-1

# Auth workflow text agents. These adapters are independent from Local VLM extraction.
# Leave providers, endpoints, model IDs, credentials and policies blank until approved.
# The supported protocol is OPENAI_COMPATIBLE_CHAT_COMPLETIONS. Remote endpoints need
# HTTPS plus *_ALLOW_REMOTE=true. *_MODEL_VERSION is an operator-pinned revision.
AUTH_WORKFLOW_MEDIA_PROVIDER=
AUTH_WORKFLOW_MEDIA_BASE_URL=
AUTH_WORKFLOW_MEDIA_MODEL=
AUTH_WORKFLOW_MEDIA_MODEL_VERSION=
AUTH_WORKFLOW_MEDIA_API_KEY=
AUTH_WORKFLOW_MEDIA_ALLOW_REMOTE=false
AUTH_WORKFLOW_MEDIA_TIMEOUT_SECONDS=20
AUTH_WORKFLOW_MEDIA_MAX_OUTPUT_TOKENS=2048
AUTH_WORKFLOW_MEDIA_MAX_RESPONSE_BYTES=262144
AUTH_WORKFLOW_MEDIA_MAX_INPUT_BYTES=1048576
AUTH_WORKFLOW_MEDIA_MAX_RETRIES=1
AUTH_WORKFLOW_MEDIA_PROMPT_VERSION=media-compliance-prompt-v1
AUTH_WORKFLOW_MEDIA_SCHEMA_VERSION=media-compliance-schema-v1
# Supply only the organization's approved, versioned content policy JSON.
AUTH_WORKFLOW_MEDIA_POLICY_JSON=

AUTH_WORKFLOW_STRATEGY_PROVIDER=
AUTH_WORKFLOW_STRATEGY_BASE_URL=
AUTH_WORKFLOW_STRATEGY_MODEL=
AUTH_WORKFLOW_STRATEGY_MODEL_VERSION=
AUTH_WORKFLOW_STRATEGY_API_KEY=
AUTH_WORKFLOW_STRATEGY_ALLOW_REMOTE=false
AUTH_WORKFLOW_STRATEGY_TIMEOUT_SECONDS=20
AUTH_WORKFLOW_STRATEGY_MAX_OUTPUT_TOKENS=2048
AUTH_WORKFLOW_STRATEGY_MAX_RESPONSE_BYTES=262144
AUTH_WORKFLOW_STRATEGY_MAX_INPUT_BYTES=1048576
AUTH_WORKFLOW_STRATEGY_MAX_RETRIES=1
AUTH_WORKFLOW_STRATEGY_PROMPT_VERSION=strategy-feasibility-prompt-v1
AUTH_WORKFLOW_STRATEGY_SCHEMA_VERSION=strategy-feasibility-schema-v1
# The backend accepts only the seven BA criteria and their fixed weights.
AUTH_WORKFLOW_STRATEGY_RUBRIC_JSON=

# Hosted Judge Demo (configure in Render, not a committed .env):
# APP_ENV remains demo; production rejects demo actors.
# DEMO_DATABASE=/tmp/organizationai/demo-organization.sqlite3
# CORS_ORIGINS=https://<actual-frontend-host> (one exact origin, no trailing slash)
# PORT is supplied by the hosting platform.

# Render Free SQLite is disposable; no submitted data persistence is promised.
